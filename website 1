<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MAKSORA - Photography & Visual Arts</title>
    <meta name="description" content="MAKSORA - Creating visual narratives that transcend the ordinary. Photography and visual arts portfolio.">
    <meta property="og:title" content="MAKSORA - Photography & Visual Arts">
    <meta property="og:description" content="Creating visual narratives that transcend the ordinary.">
    <meta property="og:type" content="website">
    
    <!-- Motion Library -->
    <script src="https://cdn.jsdelivr.net/npm/motion@11.11.13/dist/motion.js"></script>
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600&family=Inter:wght@300;400&display=swap" rel="stylesheet">
    
    <style>
        :root {
            --bg: #0a0a0b;
            --surface: #111113;
            --text: #e8e8e8;
            --text-muted: #8a8a8a;
            --accent: #c9a96e;
            --border: #1f1f22;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background: var(--bg);
            color: var(--text);
            font-family: 'Inter', sans-serif;
            overflow-x: hidden;
            cursor: none;
        }

        /* Hide cursor on mobile */
        @media (max-width: 768px) {
            body {
                cursor: auto;
            }
            .cursor-dot, .cursor-ring {
                display: none;
            }
        }

        /* Custom cursor */
        .cursor-dot {
            width: 8px;
            height: 8px;
            background: var(--accent);
            border-radius: 50%;
            position: fixed;
            pointer-events: none;
            z-index: 9999;
            transition: transform 0.2s ease;
        }

        .cursor-ring {
            width: 40px;
            height: 40px;
            border: 1px solid var(--accent);
            border-radius: 50%;
            position: fixed;
            pointer-events: none;
            z-index: 9998;
            transition: width 0.3s, height 0.3s, background 0.3s;
        }

        .cursor-ring.hover {
            width: 60px;
            height: 60px;
            background: rgba(201, 169, 110, 0.1);
        }

        /* Film grain overlay */
        .grain::after {
            content: '';
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)' opacity='0.05'/%3E%3C/svg%3E");
            pointer-events: none;
            z-index: 9997;
            opacity: 0.3;
        }

        /* Loading screen */
        .loader {
            position: fixed;
            inset: 0;
            background: var(--bg);
            z-index: 10000;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: opacity 0.5s, visibility 0.5s;
        }

        .loader.hidden {
            opacity: 0;
            visibility: hidden;
        }

        .loader-text {
            font-family: 'Space Grotesk', sans-serif;
            font-size: 3rem;
            font-weight: 300;
            letter-spacing: 0.3em;
            animation: pulse 2s ease-in-out infinite;
        }

        @keyframes pulse {
            0%, 100% { opacity: 0.3; }
            50% { opacity: 1; }
        }

        /* Navigation */
        .nav {
            position: fixed;
            top: 0;
            width: 100%;
            padding: 2rem 4rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            z-index: 1000;
            mix-blend-mode: difference;
            transition: padding 0.3s;
        }

        .nav.scrolled {
            padding: 1rem 4rem;
            background: rgba(10, 10, 11, 0.8);
            backdrop-filter: blur(10px);
        }

        .logo {
            font-family: 'Space Grotesk', sans-serif;
            font-size: 1.5rem;
            font-weight: 300;
            letter-spacing: 0.2em;
            text-decoration: none;
            color: var(--text);
        }

        .nav-links {
            display: flex;
            gap: 2rem;
        }

        .nav-link {
            text-decoration: none;
            color: var(--text);
            font-size: 0.9rem;
            letter-spacing: 0.1em;
            position: relative;
            padding: 0.5rem 0;
        }

        .nav-link::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 0;
            width: 0%;
            height: 1px;
            background: var(--accent);
            transition: width 0.3s;
        }

        .nav-link:hover::after {
            width: 100%;
        }

        /* Hero Section */
        .hero {
            height: 100vh;
            position: relative;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
        }

        .hero-image {
            position: absolute;
            inset: 0;
            background: url('https://images.unsplash.com/photo-1516035069371-29a1b244cc32?q=80&w=2000&auto=format&fit=crop') center/cover;
            filter: saturate(0.8) contrast(1.1) brightness(0.7);
            transform: scale(1.1);
        }

        .hero-overlay {
            position: absolute;
            inset: 0;
            background: linear-gradient(to bottom, rgba(10,10,11,0.3), rgba(10,10,11,0.9));
        }

        .hero-content {
            position: relative;
            z-index: 10;
            text-align: center;
        }

        .hero-title {
            font-family: 'Space Grotesk', sans-serif;
            font-size: clamp(3rem, 10vw, 7rem);
            font-weight: 300;
            letter-spacing: 0.05em;
            line-height: 1.1;
            opacity: 0;
            transform: translateY(50px);
        }

        .hero-subtitle {
            margin-top: 2rem;
            font-size: 1.1rem;
            color: var(--text-muted);
            letter-spacing: 0.3em;
            opacity: 0;
            transform: translateY(30px);
        }

        /* Work Section */
        .work {
            padding: 8rem 4rem;
            max-width: 1400px;
            margin: 0 auto;
        }

        .section-title {
            font-family: 'Space Grotesk', sans-serif;
            font-size: clamp(2rem, 4vw, 3rem);
            font-weight: 300;
            margin-bottom: 4rem;
            letter-spacing: 0.1em;
        }

        .work-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 3rem;
        }

        .work-item {
            position: relative;
            overflow: hidden;
            border-radius: 4px;
            cursor: pointer;
            background: var(--surface);
        }

        .work-image {
            width: 100%;
            height: 500px;
            object-fit: cover;
            filter: saturate(0.85) contrast(1.05) brightness(0.9);
            transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
        }

        .work-item:hover .work-image {
            transform: scale(1.03);
        }

        .work-info {
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            padding: 2rem;
            background: linear-gradient(to top, rgba(10,10,11,0.9), transparent);
            transform: translateY(20px);
            opacity: 0;
            transition: all 0.4s;
        }

        .work-item:hover .work-info {
            transform: translateY(0);
            opacity: 1;
        }

        .work-category {
            font-size: 0.8rem;
            letter-spacing: 0.2em;
            color: var(--accent);
            text-transform: uppercase;
        }

        .work-title {
            font-family: 'Space Grotesk', sans-serif;
            font-size: 1.5rem;
            font-weight: 400;
            margin-top: 0.5rem;
        }

        /* About Section */
        .about {
            padding: 8rem 4rem;
            background: var(--surface);
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 4rem;
            align-items: center;
        }

        .about-image {
            width: 100%;
            height: 600px;
            object-fit: cover;
            filter: saturate(0.7) contrast(1.1);
            border-radius: 4px;
        }

        .about-text {
            font-size: 1.3rem;
            line-height: 1.8;
            color: var(--text-muted);
        }

        .about-text strong {
            color: var(--text);
            font-weight: 400;
        }

        /* Contact CTA */
        .cta {
            padding: 8rem 4rem;
            text-align: center;
            position: relative;
            overflow: hidden;
        }

        .cta-button {
            display: inline-block;
            padding: 1.5rem 4rem;
            border: 1px solid var(--accent);
            color: var(--accent);
            text-decoration: none;
            font-size: 1.1rem;
            letter-spacing: 0.2em;
            transition: all 0.4s;
            position: relative;
            overflow: hidden;
        }

        .cta-button::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: var(--accent);
            transition: left 0.4s;
            z-index: -1;
        }

        .cta-button:hover {
            color: var(--bg);
        }

        .cta-button:hover::before {
            left: 0;
        }

        /* Footer */
        .footer {
            padding: 2rem 4rem;
            border-top: 1px solid var(--border);
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: 0.9rem;
            color: var(--text-muted);
        }

        .social-links {
            display: flex;
            gap: 2rem;
        }

        .social-link {
            color: var(--text-muted);
            text-decoration: none;
            transition: color 0.3s;
        }

        .social-link:hover {
            color: var(--accent);
        }

        /* Responsive */
        @media (max-width: 768px) {
            .nav {
                padding: 1.5rem 2rem;
            }
            
            .work {
                padding: 4rem 2rem;
            }
            
            .work-grid {
                grid-template-columns: 1fr;
                gap: 2rem;
            }
            
            .about {
                grid-template-columns: 1fr;
                padding: 4rem 2rem;
            }
            
            .about-image {
                height: 400px;
            }
            
            .cta {
                padding: 4rem 2rem;
            }
            
            .footer {
                padding: 2rem;
                flex-direction: column;
                gap: 1rem;
                text-align: center;
            }
        }
    </style>
</head>
<body>
    <!-- Loading Screen -->
    <div class="loader" id="loader">
        <div class="loader-text">MAKSORA</div>
    </div>

    <div class="grain"></div>
    <div class="cursor-dot" id="cursorDot"></div>
    <div class="cursor-ring" id="cursorRing"></div>

    <!-- Navigation -->
    <nav class="nav" id="nav">
        <a href="#" class="logo" data-magnetic>MAKSORA</a>
        <div class="nav-links">
            <a href="#work" class="nav-link" data-magnetic>WORK</a>
            <a href="#about" class="nav-link" data-magnetic>ABOUT</a>
            <a href="#contact" class="nav-link" data-magnetic>CONTACT</a>
        </div>
    </nav>

    <!-- Hero -->
    <section class="hero">
        <div class="hero-image" data-parallax></div>
        <div class="hero-overlay"></div>
        <div class="hero-content">
            <h1 class="hero-title" id="heroTitle">MAKSORA</h1>
            <p class="hero-subtitle" id="heroSubtitle">PHOTOGRAPHY & VISUAL ARTS</p>
        </div>
    </section>

    <!-- Work Section -->
    <section class="work" id="work">
        <h2 class="section-title" data-reveal>Selected Works</h2>
        <div class="work-grid">
            <div class="work-item" data-magnetic>
                <img src="https://images.unsplash.com/photo-1554048612-b6a482bc67e5?q=80&w=1000&auto=format&fit=crop" alt="Portrait Work" class="work-image" loading="lazy">
                <div class="work-info">
                    <span class="work-category">Portrait</span>
                    <h3 class="work-title">Ethereal Forms</h3>
                </div>
            </div>
            <div class="work-item" data-magnetic>
                <img src="https://images.unsplash.com/photo-1500530855697-b586d89ba3ee?q=80&w=1000&auto=format&fit=crop" alt="Landscape Work" class="work-image" loading="lazy">
                <div class="work-info">
                    <span class="work-category">Landscape</span>
                    <h3 class="work-title">Silent Horizons</h3>
                </div>
            </div>
            <div class="work-item" data-magnetic>
                <img src="https://images.unsplash.com/photo-1518709268805-4e9042af9f23?q=80&w=1000&auto=format&fit=crop" alt="Fine Art Work" class="work-image" loading="lazy">
                <div class="work-info">
                    <span class="work-category">Fine Art</span>
                    <h3 class="work-title">Chromatic Dreams</h3>
                </div>
            </div>
            <div class="work-item" data-magnetic>
                <img src="https://images.unsplash.com/photo-1449824913935-59a10b8d2000?q=80&w=1000&auto=format&fit=crop" alt="Urban Work" class="work-image" loading="lazy">
                <div class="work-info">
                    <span class="work-category">Editorial</span>
                    <h3 class="work-title">Urban Poetry</h3>
                </div>
            </div>
        </div>
    </section>

    <!-- About Section -->
    <section class="about" id="about">
        <img src="https://images.unsplash.com/photo-1452587925148-ce544e77e70d?q=80&w=1000&auto=format&fit=crop" alt="About MAKSORA" class="about-image" data-parallax loading="lazy">
        <div class="about-text" data-reveal>
            <p>Creating visual narratives that transcend the ordinary. <strong>MAKSORA</strong> blends light, shadow, and emotion to craft images that linger in memory.</p>
            <p style="margin-top: 2rem;">Based between Warsaw and Berlin, working globally.</p>
        </div>
    </section>

    <!-- CTA -->
    <section class="cta" id="contact">
        <a href="mailto:hello@maksora.eu" class="cta-button" data-magnetic>START A PROJECT</a>
    </section>

    <!-- Footer -->
    <footer class="footer">
        <span>© 2024 MAKSORA. All rights reserved.</span>
        <div class="social-links">
            <a href="#" class="social-link">Instagram</a>
            <a href="#" class="social-link">Behance</a>
            <a href="#" class="social-link">LinkedIn</a>
        </div>
    </footer>

    <script>
        const { animate, scroll, inView, stagger } = Motion;

        // Hide loader after page load
        window.addEventListener('load', () => {
            setTimeout(() => {
                document.getElementById('loader').classList.add('hidden');
                
                // Animate hero content
                animate('#heroTitle', 
                    { opacity: [0, 1], y: [50, 0] },
                    { duration: 1.5, ease: [0.16, 1, 0.3, 1] }
                );
                
                animate('#heroSubtitle', 
                    { opacity: [0, 1], y: [30, 0] },
                    { duration: 1.5, delay: 0.3, ease: [0.16, 1, 0.3, 1] }
                );
            }, 2000);
        });

        // Custom cursor
        const cursorDot = document.getElementById('cursorDot');
        const cursorRing = document.getElementById('cursorRing');
        let mouseX = 0, mouseY = 0;
        let ringX = 0, ringY = 0;

        document.addEventListener('mousemove', (e) => {
            mouseX = e.clientX;
            mouseY = e.clientY;
            
            animate(cursorDot, { 
                x: mouseX - 4, 
                y: mouseY - 4 
            }, { duration: 0.1 });
        });

        // Smooth cursor ring animation
        function animateRing() {
            ringX += (mouseX - ringX) * 0.15;
            ringY += (mouseY - ringY) * 0.15;
            
            cursorRing.style.transform = `translate(${ringX - 20}px, ${ringY - 20}px)`;
            
            requestAnimationFrame(animateRing);
        }
        animateRing();

        // Magnetic hover effect
        document.querySelectorAll('[data-magnetic]').forEach(element => {
            element.addEventListener('mousemove', (e) => {
                const rect = element.getBoundingClientRect();
                const x = e.clientX - rect.left - rect.width / 2;
                const y = e.clientY - rect.top - rect.height / 2;
                
                animate(element, {
                    x: x * 0.3,
                    y: y * 0.3
                }, { duration: 0.3 });
                
                cursorRing.classList.add('hover');
            });

            element.addEventListener('mouseleave', () => {
                animate(element, { x: 0, y: 0 }, { duration: 0.5, ease: 'backOut' });
                cursorRing.classList.remove('hover');
            });
        });

        // Parallax effect
        document.querySelectorAll('[data-parallax]').forEach(element => {
            scroll(
                animate(element, {
                    transform: ['translateY(-10%)', 'translateY(10%)']
                }),
                { target: element, offset: ['start end', 'end start'] }
            );
        });

        // Reveal animations
        document.querySelectorAll('[data-reveal]').forEach(element => {
            inView(element, () => {
                animate(element, {
                    opacity: [0, 1],
                    y: [40, 0],
                    filter: ['blur(10px)', 'blur(0px)']
                }, {
                    duration: 1,
                    ease: [0.16, 1, 0.3, 1],
                    delay: stagger(0.1)
                });
            });
        });

        // Navigation background on scroll
        scroll(
            (progress) => {
                const nav = document.getElementById('nav');
                if (progress > 0.1) {
                    nav.classList.add('scrolled');
                } else {
                    nav.classList.remove('scrolled');
                }
            }
        );

        // Smooth scroll for anchor links
        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', (e) => {
                e.preventDefault();
                const target = document.querySelector(anchor.getAttribute('href'));
                
                if (target) {
                    const targetPosition = target.getBoundingClientRect().top + window.pageYOffset;
                    
                    animate(window, {
                        scrollTo: targetPosition
                    }, {
                        duration: 1.5,
                        ease: [0.16, 1, 0.3, 1]
                    });
                }
            });
        });
    </script>
</body>
</html>
